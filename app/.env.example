# WalletConnect / Reown project id - free at https://cloud.reown.com. Enables the AppKit
# connect modal (mobile wallets, QR, the standard wallet list). Leave unset for plain
# injected-wallet buttons.
VITE_WC_PROJECT_ID=

# Dev only: which backend the app reads - local (anvil devnet + personas, needs `npm run
# dev:all`), sepolia (default) or mainnet. Deployed builds take the network from the hostname.
VITE_NETWORK=sepolia
