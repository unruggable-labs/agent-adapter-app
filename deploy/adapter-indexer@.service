# One instance per process. adapter-indexer@sepolia is the testnet alone (127.0.0.1:8788);
# adapter-indexer@hub is the mainnets in one process (127.0.0.1:8792, HUB_NETWORKS in
# /etc/adapter.env, default robinhood,base,mainnet). The instance name is what serve.ts is given.
# A chain runs in one instance only: its event log is locked by the process that has it open.
[Unit]
Description=Adapter %i indexer (event-sourced API)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/adapter/indexer
EnvironmentFile=-/etc/adapter.env
ExecStart=/srv/adapter/indexer/node_modules/.bin/tsx src/serve.ts %i
Restart=always
RestartSec=5
LimitNOFILE=65536

# Hardening (mirrors ens8004.service)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/adapter
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
