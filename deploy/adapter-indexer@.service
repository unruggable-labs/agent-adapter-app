# One indexer per network: adapter-indexer@sepolia (127.0.0.1:8788), adapter-indexer@mainnet
# (127.0.0.1:8789). The instance name is the network passed to serve.ts.
[Unit]
Description=Adapter %i indexer (event-sourced API)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/adapter/indexer
EnvironmentFile=-/etc/adapter.env
ExecStart=/srv/adapter/indexer/node_modules/.bin/tsx src/serve.ts %i
Restart=always
RestartSec=5
LimitNOFILE=65536

# Hardening (mirrors ens8004.service)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/adapter
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
