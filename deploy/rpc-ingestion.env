# Shared allowance for the hub's three mainnets. Loaded after /etc/adapter.env by the hub
# drop-in (90-rpc-budget.conf), so the values here win - change them here, not in adapter.env.
RPC_DAILY_REQUEST_LIMIT=20000
RPC_MINUTE_REQUEST_LIMIT=30
# Enrichment reads new and changed records only: the watcher's scans plus holders, names,
# cards and pictures. Ingestion keeps the remainder (12,000 a day, 18 a minute).
ENRICHMENT_MODE=events
RPC_ENRICHMENT_DAILY_LIMIT=8000
RPC_ENRICHMENT_MINUTE_LIMIT=12
# No metadata sweeps or maintenance.
RPC_MAINTENANCE_DAILY_LIMIT=0
RPC_MAINTENANCE_MINUTE_LIMIT=0
ADAPTER_OFFLINE=0
BACKFILL_TIMESTAMPS=0
VERIFY_BACKFILL=0
RPC_READS_UNTIL=
