# --- adapterscan (managed by deploy/setup.sh; everything below this line is replaced) ---
# One static build behind every hostname. The testnet has its own indexer (8788); the mainnets
# run in one process, the hub (8792), which answers a chain's own hostname with that chain alone
# and adapterscan.com with all of them. Apply this together with the hub cutover in README.md.

(adapterscan) {
	encode gzip zstd

	# The API, the social cards, and the crawlers' files come from the chain's indexer.
	handle /api/* {
		reverse_proxy 127.0.0.1:{args[0]}
	}
	handle /og/* {
		reverse_proxy 127.0.0.1:{args[0]}
	}
	handle /robots.txt {
		reverse_proxy 127.0.0.1:{args[0]}
	}
	handle /sitemap.xml {
		reverse_proxy 127.0.0.1:{args[0]}
	}

	# Built assets are served as files. Page paths (/identity/<ubid>, /address/<addr>, /) go to
	# the indexer, which returns the same index.html with the title, description and card
	# tags filled in for what the path is about - what crawlers and link unfurlers read.
	handle {
		root * /srv/adapter/app/dist
		@page not file
		reverse_proxy @page 127.0.0.1:{args[0]}
		file_server
	}

	# No indexer behind this host (a chain that is not on v0.0.17 yet): the plain shell.
	handle_errors 502 503 {
		root * /srv/adapter/app/dist
		rewrite * /index.html
		file_server
	}

	header {
		-Server
		-X-Powered-By
		Strict-Transport-Security "max-age=15768000"
	}
}

# Ports: sepolia 8788, the hub 8792. (8789-8791 were the mainnets' own indexers before the hub.)
# The hub still answers a chain's own hostname with that chain alone, should one point at it.
testnet.adapterscan.com, adapter.ens8004.xyz, adapter.178-105-235-22.sslip.io {
	import adapterscan 8788
}
# The mainnets' own hostnames from before the hub: their pages are at the apex now, on the same
# paths (a UBID or a statement id names its chain, so a shared link lands on the same record).
robinhood.adapterscan.com, base.adapterscan.com {
	redir https://adapterscan.com{uri} permanent
}
# The usage page across every chain. The page asks each chain's API itself; behind it, the hub
# draws the combined social card from its own logs.
stats.adapterscan.com {
	import adapterscan 8792
}

# The documentation site: the same build, entered through docs.html.
docs.adapterscan.com {
	encode gzip zstd
	root * /srv/adapter/app/dist
	try_files {path} /docs.html
	file_server
	header {
		-Server
		-X-Powered-By
		Strict-Transport-Security "max-age=15768000"
	}
}

# The apex: every mainnet, from the hub. Ethereum joins when MAINNET_FROM_BLOCK is set.
adapterscan.com, www.adapterscan.com {
	import adapterscan 8792
}
