# --- adapterscan (managed by deploy/setup.sh; everything below this line is replaced) ---
# One static build, two hostnames. The app picks its network from the hostname and Caddy
# routes /api to the matching indexer: Sepolia on 8788, Ethereum on 8789.

(adapterscan) {
	encode gzip zstd

	handle /api/* {
		reverse_proxy 127.0.0.1:{args[0]}
	}

	handle {
		root * /srv/adapter/app/dist
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		-X-Powered-By
		Strict-Transport-Security "max-age=15768000"
	}
}

# One hostname per chain; the app reads its network from the hostname and Caddy routes /api
# to that chain's indexer. Ports: sepolia 8788, mainnet 8789, base 8790, robinhood 8791.
testnet.adapterscan.com, adapter.ens8004.xyz, adapter.178-105-235-22.sslip.io {
	import adapterscan 8788
}
robinhood.adapterscan.com {
	import adapterscan 8791
}
# Base's adapter is not on v0.0.17 yet: the app shows a notice on this host until it is, and
# the indexer (adapter-indexer@base) starts once BASE_FROM_BLOCK is set. The route is ready.
base.adapterscan.com {
	import adapterscan 8790
}

# The documentation site: the same build, entered through docs.html.
docs.adapterscan.com {
	encode gzip zstd
	root * /srv/adapter/app/dist
	try_files {path} /docs.html
	file_server
	header {
		-Server
		-X-Powered-By
		Strict-Transport-Security "max-age=15768000"
	}
}

# The apex. Until Ethereum's adapter is on v0.0.17 the app shows the chain picker here (it
# knows the hostname); when the upgrade lands, set MAINNET_FROM_BLOCK, enable
# adapter-indexer@mainnet, and flip "adapterscan.com" to "mainnet" in app/src/lib/chain.ts.
adapterscan.com, www.adapterscan.com {
	import adapterscan 8789
}
